<Project>
  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <Version>0.8.0</Version>
    <!--
      Keep the public assemblies architecture-neutral regardless of a consuming build's Platform.
      The packages target any platform.
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
</Project>
