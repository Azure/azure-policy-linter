<Project>
  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <Version>0.12.0</Version>
    <PackageReleaseNotes>Added .NET 10 library and CLI assets while retaining .NET 8 compatibility. Builds and tests use .NET 10. Use the .NET 10 SDK and runtime for supported execution; .NET 8 has reached end of support.</PackageReleaseNotes>
    <!--
      Keep the public assemblies architecture-neutral regardless of a consuming build's Platform.
      The packages target any platform.
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
</Project>
