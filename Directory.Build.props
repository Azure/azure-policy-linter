<Project>
  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <Version>0.7.2</Version>
    <!--
      The internal publishing pipeline uses Platform=x64 for its output layout.
      Keep the public assemblies architecture-neutral because their packages target any platform.
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
</Project>
