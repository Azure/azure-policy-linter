{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/azure-policy-linter/schemas/triaged-linter-results-v2.json",
  "title": "Triaged Policy Linter Results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "summary",
    "source",
    "context",
    "errors",
    "groups"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "resultKey"
      ],
      "properties": {
        "format": {
          "enum": [
            "json",
            "console"
          ]
        },
        "resultKey": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyShape",
        "defaultEffect",
        "allowedEffects",
        "enforcementPossible"
      ],
      "properties": {
        "policyShape": {
          "enum": [
            "resource",
            "property_bag"
          ]
        },
        "defaultEffect": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowedEffects": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            {
              "const": "any"
            },
            {
              "type": "null"
            }
          ]
        },
        "enforcementPossible": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "invalid_policy",
              "invalid_results",
              "ambiguous_result",
              "no_matching_result",
              "unparseable_console",
              "system_failure"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1
          },
          "groups": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "pointer": {
      "type": "string",
      "pattern": "^(/([^~/]|~0|~1)*)*$"
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceIndexes",
        "rules",
        "decision",
        "reason",
        "recommendation",
        "targetPointers"
      ],
      "properties": {
        "sourceIndexes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision": {
          "enum": [
            "direct_edit",
            "choice_required",
            "investigate",
            "none"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "targetPointers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pointer"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "enum": [
                  "direct_edit",
                  "choice_required"
                ]
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "targetPointers": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "targetPointers": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
